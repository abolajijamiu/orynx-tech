# Database. Postgres in production; SQLite works for local runs and tests.
ORYNX_DATABASE_URL=postgresql+psycopg://orynx:orynx@localhost:5432/orynx
# ORYNX_DATABASE_URL=sqlite+pysqlite:///./orynx.db

# Identify your crawler. Site owners use this to contact you; keep it accurate.
ORYNX_USER_AGENT=OrynxBookLeads/0.1 (+https://example.com/bot; leads@example.com)

# Politeness. Applied per registrable domain unless a recipe overrides it.
ORYNX_DEFAULT_RATE_LIMIT_RPS=0.5
ORYNX_DEFAULT_CONCURRENCY=4
ORYNX_REQUEST_TIMEOUT=30
ORYNX_OBEY_ROBOTS=true

# On-disk HTTP cache. Keeps re-runs cheap and makes crawls replayable.
ORYNX_CACHE_DIR=./.cache/http
ORYNX_CACHE_TTL_HOURS=168

# Optional API keys. Every source used by default works without one.
ORYNX_GOOGLE_BOOKS_API_KEY=
ORYNX_CONTACT_EMAIL=leads@example.com
